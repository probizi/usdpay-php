{
    "name": "usdpay/sdk",
    "description": "PHP SDK for accepting USDT payments directly to your wallet with automatic payment verification and webhooks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://usdpay.me/",
    "keywords": [
        "usdpay",
        "usdt",
        "usdt payments",
        "crypto payments",
        "payment gateway",
        "crypto payment gateway",
        "payment api",
        "usdt api",
        "webhook",
        "tron",
        "trc20",
        "ton",
        "bep20",
        "bsc"
    ],
    "support": {
        "docs": "https://usdpay.me/docs/payments",
        "issues": "https://github.com/probizi/usdpay-php/issues",
        "source": "https://github.com/probizi/usdpay-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "USDPAY\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "USDPAY\\SDK\\Tests\\": "tests/"
        }
    }
}
